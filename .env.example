# Daraja SANDBOX credentials (https://developer.safaricom.co.ke). Never commit a real .env.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke

# Where Daraja posts STK push results. Must be a public https URL you control (a tunnel is fine for sandbox).
# The webhook receiver is not built yet; until then `sandbox-check` and --query/--push work without it.
DARAJA_CALLBACK_URL=

# Encrypts payer phone numbers at rest (needed to re-push to the same payer). Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it the sandbox stores numbers in plaintext (allowed only for sandbox / loopback URLs).
PAYRECON_PII_KEY=

# Reversals (refunds of duplicate payments). Sandbox initiator from the Daraja portal; the certificate is
# Safaricom's public certificate for the environment (SandboxCertificate.cer converted to PEM).
DARAJA_INITIATOR=
DARAJA_INITIATOR_PASSWORD=
DARAJA_CERT_PATH=
# Or skip the certificate: paste the ready-made Security Credential the portal's Reversals simulator shows.
DARAJA_SECURITY_CREDENTIAL=
# Leave these two empty to derive them from DARAJA_CALLBACK_URL (.../daraja/reversal-result/<token> and .../reversal-timeout/<token>).
DARAJA_RESULT_URL=
DARAJA_TIMEOUT_URL=

# C2B (customer pays the paybill). The sandbox C2B test shortcode from the portal's test credentials (a 600xxx number);
# empty means DARAJA_SHORTCODE. Register the URLs with: python -m payrecon.recover c2b-register
DARAJA_C2B_SHORTCODE=
# Shortcode used as ReceiverParty in reversals; empty means DARAJA_C2B_SHORTCODE, else DARAJA_SHORTCODE.
DARAJA_REVERSAL_SHORTCODE=

# Payroll (B2C: paying people). Needs DARAJA_INITIATOR plus DARAJA_SECURITY_CREDENTIAL (or password + certificate).
# The shortcode that pays out; empty means DARAJA_C2B_SHORTCODE. CommandID: BusinessPayment, SalaryPayment or PromotionPayment.
# The result and timeout URLs follow DARAJA_CALLBACK_URL (.../daraja/b2c-result/<token>) unless set.
DARAJA_B2C_SHORTCODE=
DARAJA_B2C_COMMAND=BusinessPayment
DARAJA_B2C_RESULT_URL=
DARAJA_B2C_TIMEOUT_URL=

# Comma-separated names allowed to approve refunds and linked payments (a stand-in for real authentication).
PAYRECON_APPROVERS=

# Webhook receiver (`python -m payrecon.recover serve --db app.db`). Daraja does not sign callbacks, so the URL itself is
# the secret: put this token in every callback URL (see what `serve` prints). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PAYRECON_WEBHOOK_TOKEN=
# Confirm every STK success with Daraja's query before it reaches the ledger (default on; 0 turns it off).
PAYRECON_VERIFY_SUCCESS=1
# Optional: comma-separated IPs allowed to post. Applies to the direct peer, so it is useless behind a tunnel or proxy.
PAYRECON_WEBHOOK_ALLOW_IPS=

